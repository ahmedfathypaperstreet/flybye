{
  "version": 1,
  "sdk_version": "0.26.2",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://nqgpciewfajrcingdlgl.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "flybye",
      "version": "0.1.0",
      "title": "FlyBye"
    },
    "tools": [
      {
        "name": "get_my_profile",
        "title": "Get my profile",
        "description": "Get the signed-in traveler's FlyBye profile, including verification status and connection mode.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_my_flights",
        "title": "List my flights",
        "description": "List the signed-in traveler's saved flights and layovers, soonest departure first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "Maximum number of flights to return (default 20)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "add_flight",
        "title": "Add a flight",
        "description": "Save a flight (with optional layover) to the signed-in traveler's FlyBye itinerary.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "departure_airport": {
              "type": "string",
              "pattern": "^[A-Za-z]{3}$",
              "description": "Departure airport IATA code, e.g. JFK."
            },
            "arrival_airport": {
              "$ref": "#/properties/departure_airport",
              "description": "Arrival airport IATA code, e.g. LHR."
            },
            "departure_time": {
              "type": "string",
              "format": "date-time",
              "description": "Departure time as an ISO 8601 timestamp."
            },
            "arrival_time": {
              "type": "string",
              "format": "date-time",
              "description": "Arrival time as an ISO 8601 timestamp."
            },
            "flight_number": {
              "type": "string",
              "maxLength": 12,
              "description": "Flight number, e.g. BA178."
            },
            "layover_airport": {
              "$ref": "#/properties/departure_airport",
              "description": "Layover airport IATA code, if any."
            },
            "layover_duration_minutes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2880,
              "description": "Layover length in minutes."
            }
          },
          "required": [
            "departure_airport",
            "arrival_airport",
            "departure_time",
            "arrival_time"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_my_matches",
        "title": "List my matches",
        "description": "List the signed-in traveler's FlyBye matches and their status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "accepted",
                "declined"
              ],
              "description": "Filter by match status."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "Maximum matches to return (default 20)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_messages",
        "title": "List messages in a match",
        "description": "Read the most recent chat messages in one of the signed-in traveler's matches.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "match_id": {
              "type": "string",
              "format": "uuid",
              "description": "The match ID to read messages from."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Maximum messages to return (default 30)."
            }
          },
          "required": [
            "match_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "send_message",
        "title": "Send a message",
        "description": "Send a text message as the signed-in traveler in one of their accepted FlyBye matches.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "match_id": {
              "type": "string",
              "format": "uuid",
              "description": "The match ID to send the message in."
            },
            "content": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "description": "Message text to send."
            }
          },
          "required": [
            "match_id",
            "content"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
