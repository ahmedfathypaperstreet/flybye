<!--
  Paste these keys into ios/Runner/Info.plist (inside the top-level <dict>).
  Don't replace the whole file — Flutter's default Info.plist already has the
  keys it needs (CFBundleName, UILaunchStoryboardName, etc.); you're adding
  to it.
-->

<!-- 1. URL scheme for the password-reset deep link -->
<key>CFBundleURLTypes</key>
<array>
  <dict>
    <key>CFBundleTypeRole</key>
    <string>Editor</string>
    <key>CFBundleURLSchemes</key>
    <array>
      <string>flybye</string>
    </array>
  </dict>
</array>

<!-- 2. Permissions strings (required for App Store review) -->
<key>NSCameraUsageDescription</key>
<string>FlyBye needs your camera to take a verification selfie when you sign up.</string>

<key>NSPhotoLibraryUsageDescription</key>
<string>FlyBye uses your photos so you can pick a profile picture.</string>

<key>NSPhotoLibraryAddUsageDescription</key>
<string>FlyBye saves photos you share in chat.</string>

<key>NSMicrophoneUsageDescription</key>
<string>FlyBye does not record audio. This permission is reserved for future voice messages.</string>

<!-- 3. Background modes — only enable if/when you wire push notifications -->
<!--
<key>UIBackgroundModes</key>
<array>
  <string>remote-notification</string>
</array>
-->

<!-- 4. App Transport Security — Supabase + RevenueCat are HTTPS only,
     so we don't need any exceptions. Leaving the default ATS is correct. -->

<!-- 5. Encryption export compliance -->
<key>ITSAppUsesNonExemptEncryption</key>
<false/>
